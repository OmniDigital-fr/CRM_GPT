# Set these securely in Hostinger environment variables. Never commit values.
NODE_ENV=production
CRM_PUBLIC_URL=https://crm2.omnidigital.fr
CRM_AUTH_USER=
CRM_AUTH_PASSWORD=
# Absolute writable persistent path OUTSIDE the build/deployment directory.
# Obtain the real path for your account from hPanel; do not use this placeholder.
CRM_DATA_DIR=
# Optional for Google audits:
PAGESPEED_API_KEY=
# PORT is supplied by Hostinger. Do not override it there.
# Hostinger mailbox. Fill the password ONLY in hPanel environment variables.
MAIL_PROVIDER=hostinger
MAIL_USER=contact@omnidigital.fr
MAIL_PASSWORD=
MAIL_FROM_NAME=OmniDigital
