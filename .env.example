# Set these securely in Hostinger environment variables. Never commit values.
NODE_ENV=production
CRM_PUBLIC_URL=https://crm2.omnidigital.fr
CRM_AUTH_USER=
CRM_AUTH_PASSWORD=
# Absolute writable persistent path OUTSIDE the build/deployment directory.
# Obtain the real path for your account from hPanel; do not use this placeholder.
CRM_DATA_DIR=
# Optional for Google audits:
PAGESPEED_API_KEY=
# PORT is supplied by Hostinger. Do not override it there.
# Hostinger mailbox. Fill the password ONLY in hPanel environment variables.
MAIL_PROVIDER=hostinger
MAIL_USER=contact@omnidigital.fr
MAIL_PASSWORD=
MAIL_FROM_NAME=OmniDigital
# Qualification IA facultative — exclusivement côté serveur, jamais dans static/.
# Sans clé, les scores déterministes et le CRM continuent à fonctionner.
OPENAI_API_KEY=
OPENAI_QUALIFICATION_MODEL=gpt-4.1-mini-2025-04-14
QUALIFICATION_DAILY_BUDGET_USD=1
QUALIFICATION_MONTHLY_BUDGET_USD=5
QUALIFICATION_MAX_PER_HOUR=10
QUALIFICATION_COOLDOWN_SECONDS=60
QUALIFICATION_MAX_OUTPUT_TOKENS=1800
QUALIFICATION_TIMEOUT_SECONDS=45
# Tarifs USD / million de tokens ; à vérifier lors d'un changement de modèle.
QUALIFICATION_INPUT_USD_PER_MILLION=0.40
QUALIFICATION_OUTPUT_USD_PER_MILLION=1.60
