# Set these securely in Hostinger environment variables. Never commit values.
NODE_ENV=production
CRM_PUBLIC_URL=https://crm2.omnidigital.fr
CRM_AUTH_USER=
CRM_AUTH_PASSWORD=
# Absolute writable persistent path OUTSIDE the build/deployment directory.
# Obtain the real path for your account from hPanel; do not use this placeholder.
CRM_DATA_DIR=
# Optional for Google audits:
PAGESPEED_API_KEY=
# PORT is supplied by Hostinger. Do not override it there.
# Hostinger mailbox. Fill the password ONLY in hPanel environment variables.
MAIL_PROVIDER=hostinger
MAIL_USER=contact@omnidigital.fr
MAIL_PASSWORD=
MAIL_FROM_NAME=OmniDigital
# Qualification IA facultative — exclusivement côté serveur, jamais dans static/.
# Sans clé, les scores déterministes et le CRM continuent à fonctionner.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_ENABLED=true
# free-test : test fictif uniquement, avec un projet sans facturation confirmé.
GEMINI_BILLING_MODE=free-test
GEMINI_FREE_PROJECT_CONFIRMED=false
# Activez uniquement après avoir vérifié les conditions et le traitement des données.
GEMINI_ALLOW_CRM_DATA=false
QUALIFICATION_MAX_PER_HOUR=5
QUALIFICATION_MAX_PER_DAY=15
QUALIFICATION_MAX_PER_MONTH=150
QUALIFICATION_COOLDOWN_SECONDS=60
QUALIFICATION_MAX_OUTPUT_TOKENS=1800
QUALIFICATION_TIMEOUT_SECONDS=45
# Plafonds locaux en mode paid. Pour un autre modèle, renseignez ses tarifs réels.
QUALIFICATION_DAILY_BUDGET_USD=1
QUALIFICATION_MONTHLY_BUDGET_USD=5
QUALIFICATION_INPUT_USD_PER_MILLION=0.30
QUALIFICATION_OUTPUT_USD_PER_MILLION=2.50

# Enrichissement facultatif — vérifier le plan et les conditions de Brave avant activation.
PROSPECT_BRAVE_ENABLED=false
PROSPECT_BRAVE_API_KEY=
PROSPECT_BRAVE_MONTHLY=300
PROSPECT_ENRICHMENT_BATCH=10
